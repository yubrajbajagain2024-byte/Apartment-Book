<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A full backup of production every day at 09:00, by scripts/backup-daily.sh (its header says how to install this). -->
  <key>Label</key>
  <string>com.unibuzz.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/sunilsherpa/Downloads/UniBuzz/scripts/backup-daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/sunilsherpa/CampConnect-backups/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sunilsherpa/CampConnect-backups/backup.log</string>
</dict>
</plist>

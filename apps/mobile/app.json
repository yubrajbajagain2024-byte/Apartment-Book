{
  "expo": {
    "name": "Apartment Book",
    "slug": "apartment-book",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apartmentbook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.apartmentbook.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "CampConnect uses your camera for video calls, and to take photos and record videos for Snaps, posts and listings, like video tours of your place.",
        "NSPhotoLibraryUsageDescription": "Apartment Book needs your photo library to add photos and videos to your listings and profile.",
        "NSMicrophoneUsageDescription": "CampConnect uses the microphone for audio and video calls, voice messages and video tours.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.apartmentbook.app",
      "adaptiveIcon": {
        "backgroundColor": "#1877f2",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1877f2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Apartment Book needs your photo library to add photos and videos to your listings.",
          "cameraPermission": "CampConnect uses your camera for video calls, and to take photos and record videos for Snaps, posts and listings, like video tours of your place."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1877f2",
          "sounds": [
            "./assets/sounds/ring.wav"
          ]
        }
      ],
      "expo-video",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "4e98759f-dbc5-4217-b4cb-ec8030ffce49"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4e98759f-dbc5-4217-b4cb-ec8030ffce49"
    }
  }
}

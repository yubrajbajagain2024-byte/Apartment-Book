# Copy this file to .env.local. The admin app talks to the SAME Supabase project as the website.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of THIS admin app (no trailing slash). Used for auth redirects; add
# <this url>/auth/callback to Supabase -> Authentication -> URL configuration -> Redirect URLs.
# Local: http://localhost:3001   Production: https://admin.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Public URL of the student website, for "open on site" links.
NEXT_PUBLIC_MAIN_SITE_URL=http://localhost:3000

# Server only, never exposed to the browser. Needed for staff invitation emails (Supabase Auth
# sends them through the project's SMTP settings) and for the media worker.
SUPABASE_SERVICE_ROLE_KEY=

# The media clean-up worker moves hidden photos to the private quarantine bucket and deletes
# removed files and videos. It runs ONLY when this is exactly "true" (and the key above is set);
# the service-role key alone never turns it on. Leave it unset until you have reviewed the queue.
MEDIA_WORKER_ENABLED=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Set to "off" to hide "Continue with Google" while the Google provider is not enabled in Supabase.
NEXT_PUBLIC_GOOGLE_LOGIN=on

# Protects GET/POST /api/media/worker (the retry sweep). Vercel sends it automatically
# for the cron job in vercel.json when the variable is set in the project.
CRON_SECRET=
